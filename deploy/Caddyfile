{
	email erdii.kuss@gmail.com
	auto_https off
}

(ssl_only) {
	@insecure header CF-Visitor {"scheme":"http"}
	redir @insecure https://{host}{uri} 301
	@secure header CF-Visitor {"scheme":"https"}
	header @secure Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

http://erdikus.me, http://www.erdikus.me {
	import ssl_only
	encode gzip
	reverse_proxy site:3000 {
		header_up CF-IPCountry {http.request.header.CF-IPCountry}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
	}
}

http://movie.erdikus.me {
	import ssl_only
	reverse_proxy movie:8501 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		flush_interval -1
	}
}

http://crm.erdikus.me {
	import ssl_only
	reverse_proxy crm:8501 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		flush_interval -1
	}
}

:80 {
	redir https://erdikus.me{uri} 301
}
